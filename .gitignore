__pycache__/
*.py[cod]
.DS_Store
.venv/
.env
.env.*
/config/settings.json
/config/secrets/
dist/
build/
*.egg-info/
runtime/
state/
logs/

# Real-browser UI artifacts: PNG screenshots + captured network logs are
# regenerated each run and are environment-specific binaries (RISK-UI-EXEC-1).
tests/system/artifacts/

# Test run evidence (plan §7 / STD repository-layout.md §4.1.1).
# Framework machine output (JUnit XML + captured logs) lives under
# reports/<run-id>/artifacts/ and is regenerated each run -> ignored.
# The formal report (+metadata), the flat per-case <Case ID>.json and
# case-status.json / test-run.env at the run root ARE committed, so we never
# ignore the whole reports/ tree.
tests/**/reports/*/artifacts/

# Legacy/large raw outputs from earlier layouts (kept ignored for safety).
tests/**/reports/*/junit.xml
tests/**/reports/*/pytest.log
tests/**/reports/*/cases/

