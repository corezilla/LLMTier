{
  "openapi": "3.1.0",
  "info": {
    "title": "LLMTier V0.3 Simplified Contract",
    "version": "0.3-simplified-candidate.2",
    "description": "OpenAI-compatible stateless model gateway candidate. Not runtime active."
  },
  "servers": [{"url": "https://llmtier.example.invalid"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/v1/responses": {
      "post": {
        "operationId": "createResponse",
        "summary": "Create one model response from complete caller input; standard JSON or SSE",
        "parameters": [{"$ref": "#/components/parameters/TraceParent"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResponsesRequest"}}}},
        "responses": {
          "200": {"description": "Completed JSON response when stream=false, or standard Responses SSE when stream=true", "headers": {"X-Request-ID": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResponsesResponse"}}, "text/event-stream": {"schema": {"type": "string"}, "x-event-data-schema": {"$ref": "#/components/schemas/ResponseStreamEvent"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ModelNotFound"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "502": {"$ref": "#/components/responses/ProviderFailure"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/v1/embeddings": {
      "post": {
        "operationId": "createEmbedding",
        "summary": "Create embeddings with an embedding-capable logical model",
        "parameters": [{"$ref": "#/components/parameters/TraceParent"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmbeddingRequest"}}}},
        "responses": {
          "200": {"description": "Embedding response", "headers": {"X-Request-ID": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmbeddingResponse"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ModelNotFound"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "502": {"$ref": "#/components/responses/ProviderFailure"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "listModels",
        "responses": {
          "200": {"description": "Visible logical models", "headers": {"X-Request-ID": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ModelList"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/v1/models/{model}": {
      "get": {
        "operationId": "getModel",
        "parameters": [{"name": "model", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}, "description": "Exact case-sensitive logical model ID"}],
        "responses": {
          "200": {"description": "Logical model", "headers": {"X-Request-ID": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Model"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ModelNotFound"}
        }
      }
    },
    "/tier/v1/usage": {
      "get": {
        "operationId": "listUsage",
        "summary": "Minimal token usage query for the authenticated caller",
        "parameters": [
          {"name": "from", "in": "query", "required": true, "schema": {"type": "string", "format": "date-time"}},
          {"name": "to", "in": "query", "required": true, "schema": {"type": "string", "format": "date-time"}},
          {"name": "model", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "request_id", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "cursor", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 100}}
        ],
        "responses": {
          "200": {"description": "Token usage records", "headers": {"X-Request-ID": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UsagePage"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/healthz": {
      "get": {"operationId": "getHealth", "security": [], "responses": {"200": {"description": "Process is alive", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthView"}}}}}}
    },
    "/readyz": {
      "get": {"operationId": "getReadiness", "responses": {"200": {"description": "Service can accept requests", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReadinessView"}}}}, "503": {"$ref": "#/components/responses/Unavailable"}}}
    },
    "/tier/admin/v1/providers": {
      "get": {"operationId": "listProviders", "security": [{"AdminBearerAuth": []}], "responses": {"200": {"description": "Providers", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/ProviderView"}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}},
      "post": {"operationId": "createProvider", "security": [{"AdminBearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderWrite"}}}}, "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderView"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/tier/admin/v1/providers/{provider_id}": {
      "parameters": [{"name": "provider_id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "get": {"operationId": "getProvider", "security": [{"AdminBearerAuth": []}], "responses": {"200": {"description": "Provider", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderView"}}}}, "404": {"$ref": "#/components/responses/NotFound"}}},
      "patch": {"operationId": "updateProvider", "security": [{"AdminBearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderWrite"}}}}, "responses": {"200": {"description": "Updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderView"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}}},
      "delete": {"operationId": "deleteProvider", "security": [{"AdminBearerAuth": []}], "responses": {"204": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/tier/admin/v1/deployments": {
      "get": {"operationId": "listDeployments", "security": [{"AdminBearerAuth": []}], "responses": {"200": {"description": "Deployments", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/DeploymentView"}}}}}}},
      "post": {"operationId": "createDeployment", "security": [{"AdminBearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeploymentWrite"}}}}, "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeploymentView"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/tier/admin/v1/deployments/{deployment_id}": {
      "parameters": [{"name": "deployment_id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "get": {"operationId": "getDeployment", "security": [{"AdminBearerAuth": []}], "responses": {"200": {"description": "Deployment", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeploymentView"}}}}, "404": {"$ref": "#/components/responses/NotFound"}}},
      "patch": {"operationId": "updateDeployment", "security": [{"AdminBearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeploymentWrite"}}}}, "responses": {"200": {"description": "Updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeploymentView"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}}},
      "delete": {"operationId": "deleteDeployment", "security": [{"AdminBearerAuth": []}], "responses": {"204": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/tier/admin/v1/service-levels": {
      "get": {"operationId": "listServiceLevels", "security": [{"AdminBearerAuth": []}], "responses": {"200": {"description": "Service levels", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/ServiceLevelView"}}}}}}},
      "post": {"operationId": "createServiceLevel", "security": [{"AdminBearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ServiceLevelWrite"}}}}, "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ServiceLevelView"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/tier/admin/v1/service-levels/{service_level_id}": {
      "parameters": [{"name": "service_level_id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "get": {"operationId": "getServiceLevel", "security": [{"AdminBearerAuth": []}], "responses": {"200": {"description": "Service level", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ServiceLevelView"}}}}, "404": {"$ref": "#/components/responses/NotFound"}}},
      "patch": {"operationId": "updateServiceLevel", "security": [{"AdminBearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ServiceLevelWrite"}}}}, "responses": {"200": {"description": "Updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ServiceLevelView"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}}},
      "delete": {"operationId": "deleteServiceLevel", "security": [{"AdminBearerAuth": []}], "responses": {"204": {"description": "Deleted"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}}}
    },
    "/tier/admin/v1/probes": {
      "post": {"operationId": "probeDeployment", "summary": "Authorized provider/local deployment probe; may incur cost", "security": [{"AdminBearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProbeRequest"}}}}, "responses": {"200": {"description": "Probe result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProbeResult"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "502": {"$ref": "#/components/responses/ProviderFailure"}}}
    },
    "/tier/admin/v1/usage": {
      "get": {"operationId": "getAdminUsage", "security": [{"AdminBearerAuth": []}], "parameters": [{"name": "from", "in": "query", "required": true, "schema": {"type": "string", "format": "date-time"}}, {"name": "to", "in": "query", "required": true, "schema": {"type": "string", "format": "date-time"}}], "responses": {"200": {"description": "Administrative token usage", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UsagePage"}}}}}}
    },
    "/tier/admin/v1/audit": {
      "get": {"operationId": "listAuditEvents", "security": [{"AdminBearerAuth": []}], "responses": {"200": {"description": "Sanitized audit events", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/AuditEvent"}}}}}}}
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer"},
      "AdminBearerAuth": {"type": "http", "scheme": "bearer"}
    },
    "parameters": {
      "TraceParent": {"name": "traceparent", "in": "header", "required": false, "schema": {"type": "string", "maxLength": 256}}
    },
    "headers": {
      "RequestId": {"description": "Server-generated request correlation ID; not a session or idempotency key", "schema": {"type": "string", "minLength": 8, "maxLength": 128}},
      "RetryAfter": {"description": "Standard retry delay", "schema": {"type": "integer", "minimum": 0}}
    },
    "responses": {
      "BadRequest": {"description": "Invalid request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "Unauthorized": {"description": "Authentication failed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "NotFound": {"description": "Resource not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "ModelNotFound": {"description": "Exact logical model not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "Conflict": {"description": "Resource conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "RateLimited": {"description": "Internal protection rejected or delayed the request", "headers": {"Retry-After": {"$ref": "#/components/headers/RetryAfter"}, "X-Request-ID": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "ProviderFailure": {"description": "Backend failed", "headers": {"X-Request-ID": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "Unavailable": {"description": "Service or required model unavailable", "headers": {"Retry-After": {"$ref": "#/components/headers/RetryAfter"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}
    },
    "schemas": {
      "ErrorDetail": {"type": "object", "additionalProperties": false, "required": ["message", "type", "code", "param"], "properties": {"message": {"type": "string"}, "type": {"type": "string"}, "code": {"type": "string"}, "param": {"type": ["string", "null"]}}},
      "ErrorEnvelope": {"type": "object", "additionalProperties": false, "required": ["error"], "properties": {"error": {"$ref": "#/components/schemas/ErrorDetail"}}},
      "MessageInput": {"type": "object", "additionalProperties": false, "required": ["type", "role", "content"], "properties": {"type": {"const": "message"}, "role": {"enum": ["system", "developer", "user", "assistant"]}, "content": {"oneOf": [{"type": "string"}, {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["input_text", "input_image"]}, "text": {"type": "string"}, "image_url": {"type": "string"}}}}]}}},
      "FunctionCallInput": {"type": "object", "additionalProperties": false, "required": ["type", "call_id", "name", "arguments"], "properties": {"type": {"const": "function_call"}, "call_id": {"type": "string"}, "name": {"type": "string"}, "arguments": {"type": "string"}}},
      "FunctionCallOutputInput": {"type": "object", "additionalProperties": false, "required": ["type", "call_id", "output"], "properties": {"type": {"const": "function_call_output"}, "call_id": {"type": "string"}, "output": {"type": "string"}}},
      "ResponseInputItem": {"oneOf": [{"$ref": "#/components/schemas/MessageInput"}, {"$ref": "#/components/schemas/FunctionCallInput"}, {"$ref": "#/components/schemas/FunctionCallOutputInput"}]},
      "FunctionTool": {"type": "object", "additionalProperties": false, "required": ["type", "name", "parameters"], "properties": {"type": {"const": "function"}, "name": {"type": "string"}, "description": {"type": "string"}, "parameters": {"type": "object"}, "strict": {"type": "boolean", "default": false}}},
      "ResponsesRequest": {"type": "object", "additionalProperties": false, "required": ["model", "input"], "properties": {"model": {"type": "string", "minLength": 1}, "input": {"oneOf": [{"type": "string"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/components/schemas/ResponseInputItem"}}]}, "tools": {"type": "array", "items": {"$ref": "#/components/schemas/FunctionTool"}}, "tool_choice": {"oneOf": [{"enum": ["auto", "none", "required"]}, {"type": "object"}]}, "temperature": {"type": "number", "minimum": 0, "maximum": 2}, "max_output_tokens": {"type": "integer", "minimum": 1}, "stream": {"type": "boolean", "default": false}, "metadata": {"type": "object", "additionalProperties": {"type": "string"}}}},
      "OutputMessage": {"type": "object", "additionalProperties": false, "required": ["type", "role", "content"], "properties": {"type": {"const": "message"}, "role": {"const": "assistant"}, "content": {"type": "array", "items": {"type": "object", "required": ["type", "text"], "properties": {"type": {"const": "output_text"}, "text": {"type": "string"}}}}}},
      "OutputFunctionCall": {"type": "object", "additionalProperties": false, "required": ["type", "call_id", "name", "arguments"], "properties": {"type": {"const": "function_call"}, "call_id": {"type": "string"}, "name": {"type": "string"}, "arguments": {"type": "string"}}},
      "ResponseOutputItem": {"oneOf": [{"$ref": "#/components/schemas/OutputMessage"}, {"$ref": "#/components/schemas/OutputFunctionCall"}]},
      "TokenUsage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "total_tokens"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}, "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0}, "measurement_status": {"enum": ["measured", "estimated"]}, "source": {"enum": ["provider", "gateway_estimate"]}}},
      "ResponsesResponse": {"type": "object", "additionalProperties": false, "required": ["id", "object", "created_at", "status", "model", "output", "usage", "error"], "properties": {"id": {"type": "string"}, "object": {"const": "response"}, "created_at": {"type": "integer"}, "status": {"enum": ["completed", "failed", "incomplete"]}, "model": {"type": "string"}, "output": {"type": "array", "items": {"$ref": "#/components/schemas/ResponseOutputItem"}}, "usage": {"oneOf": [{"$ref": "#/components/schemas/TokenUsage"}, {"type": "null"}]}, "error": {"oneOf": [{"$ref": "#/components/schemas/ErrorDetail"}, {"type": "null"}]}}},
      "StreamingResponseView": {"type": "object", "additionalProperties": true, "required": ["id", "object", "status", "model", "output", "usage", "error"], "properties": {"id": {"type": "string"}, "object": {"const": "response"}, "created_at": {"type": "integer"}, "status": {"enum": ["in_progress", "completed", "failed", "incomplete"]}, "model": {"type": "string"}, "output": {"type": "array", "items": {"$ref": "#/components/schemas/ResponseOutputItem"}}, "usage": {"oneOf": [{"$ref": "#/components/schemas/TokenUsage"}, {"type": "null"}]}, "error": {"oneOf": [{"$ref": "#/components/schemas/ErrorDetail"}, {"type": "null"}]}}},
      "ResponseCreatedEvent": {"type": "object", "additionalProperties": true, "required": ["type", "sequence_number", "response"], "properties": {"type": {"const": "response.created"}, "sequence_number": {"type": "integer", "minimum": 0}, "response": {"$ref": "#/components/schemas/StreamingResponseView"}}},
      "ResponseOutputItemEvent": {"type": "object", "additionalProperties": true, "required": ["type", "sequence_number", "output_index", "item"], "properties": {"type": {"enum": ["response.output_item.added", "response.output_item.done"]}, "sequence_number": {"type": "integer", "minimum": 0}, "output_index": {"type": "integer", "minimum": 0}, "item": {"$ref": "#/components/schemas/ResponseOutputItem"}}},
      "ResponseOutputTextDeltaEvent": {"type": "object", "additionalProperties": true, "required": ["type", "sequence_number", "output_index", "content_index", "delta"], "properties": {"type": {"const": "response.output_text.delta"}, "sequence_number": {"type": "integer", "minimum": 0}, "output_index": {"type": "integer", "minimum": 0}, "content_index": {"type": "integer", "minimum": 0}, "delta": {"type": "string"}}},
      "ResponseFunctionArgumentsEvent": {"type": "object", "additionalProperties": true, "required": ["type", "sequence_number", "output_index", "item_id"], "properties": {"type": {"enum": ["response.function_call_arguments.delta", "response.function_call_arguments.done"]}, "sequence_number": {"type": "integer", "minimum": 0}, "output_index": {"type": "integer", "minimum": 0}, "item_id": {"type": "string"}, "delta": {"type": "string"}, "arguments": {"type": "string"}}, "allOf": [{"if": {"properties": {"type": {"const": "response.function_call_arguments.delta"}}}, "then": {"required": ["delta"]}}, {"if": {"properties": {"type": {"const": "response.function_call_arguments.done"}}}, "then": {"required": ["arguments"]}}]},
      "ResponseTerminalEvent": {"type": "object", "additionalProperties": true, "required": ["type", "sequence_number", "response"], "properties": {"type": {"enum": ["response.completed", "response.incomplete", "response.failed"]}, "sequence_number": {"type": "integer", "minimum": 0}, "response": {"$ref": "#/components/schemas/StreamingResponseView"}}},
      "ResponseErrorEvent": {"type": "object", "additionalProperties": true, "required": ["type", "sequence_number", "code", "message"], "properties": {"type": {"const": "error"}, "sequence_number": {"type": "integer", "minimum": 0}, "code": {"type": "string"}, "message": {"type": "string"}, "param": {"type": ["string", "null"]}}},
      "ResponseStreamEvent": {"oneOf": [{"$ref": "#/components/schemas/ResponseCreatedEvent"}, {"$ref": "#/components/schemas/ResponseOutputItemEvent"}, {"$ref": "#/components/schemas/ResponseOutputTextDeltaEvent"}, {"$ref": "#/components/schemas/ResponseFunctionArgumentsEvent"}, {"$ref": "#/components/schemas/ResponseTerminalEvent"}, {"$ref": "#/components/schemas/ResponseErrorEvent"}]},
      "EmbeddingRequest": {"type": "object", "additionalProperties": false, "required": ["model", "input"], "properties": {"model": {"type": "string", "minLength": 1}, "input": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}]}, "encoding_format": {"enum": ["float", "base64"], "default": "float"}, "dimensions": {"type": "integer", "minimum": 1}, "user": {"type": "string"}}},
      "EmbeddingItem": {"type": "object", "additionalProperties": false, "required": ["object", "index", "embedding"], "properties": {"object": {"const": "embedding"}, "index": {"type": "integer", "minimum": 0}, "embedding": {"oneOf": [{"type": "array", "minItems": 1, "items": {"type": "number"}}, {"type": "string", "contentEncoding": "base64"}]}}},
      "EmbeddingUsage": {"type": "object", "additionalProperties": false, "required": ["prompt_tokens", "total_tokens", "measurement_status", "source"], "properties": {"prompt_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}, "measurement_status": {"enum": ["measured", "estimated"]}, "source": {"enum": ["provider", "gateway_estimate"]}}},
      "EmbeddingResponse": {"type": "object", "additionalProperties": false, "required": ["object", "data", "model", "usage"], "properties": {"object": {"const": "list"}, "data": {"type": "array", "items": {"$ref": "#/components/schemas/EmbeddingItem"}}, "model": {"type": "string"}, "usage": {"oneOf": [{"$ref": "#/components/schemas/EmbeddingUsage"}, {"type": "null"}]}}},
      "ModelCapabilities": {"type": "object", "additionalProperties": false, "required": ["responses", "embeddings", "tools", "structured_outputs", "input_modalities", "output_modalities", "context_window", "max_output_tokens"], "properties": {"responses": {"type": "boolean"}, "embeddings": {"type": "boolean"}, "tools": {"type": "boolean"}, "structured_outputs": {"type": "boolean"}, "input_modalities": {"type": "array", "items": {"type": "string"}}, "output_modalities": {"type": "array", "items": {"type": "string"}}, "context_window": {"type": ["integer", "null"], "minimum": 1}, "max_output_tokens": {"type": ["integer", "null"], "minimum": 1}}},
      "Model": {"type": "object", "additionalProperties": false, "required": ["id", "object", "created", "owned_by", "availability", "capabilities"], "properties": {"id": {"type": "string"}, "object": {"const": "model"}, "created": {"type": "integer"}, "owned_by": {"const": "llmtier"}, "availability": {"enum": ["available", "degraded", "unavailable"]}, "capabilities": {"$ref": "#/components/schemas/ModelCapabilities"}}},
